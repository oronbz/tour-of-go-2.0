---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { chapters } from '../lib/chapters';

interface Props {
  title: string;
  chapter: number;
  allLessons: Array<{
    id: string;
    data: { title: string; lesson: number; chapter: number };
  }>;
  currentLessonId: string;
}

const { title, chapter, allLessons, currentLessonId } = Astro.props;

const chapterLessons = allLessons
  .filter((l) => l.data.chapter === chapter)
  .sort((a, b) => a.data.lesson - b.data.lesson);

const chapterMeta = chapters.find((c) => c.number === chapter);
const chapterTitle = chapterMeta ? chapterMeta.title : `Chapter ${chapter}`;
---

<BaseLayout title={title}>
  <div class="flex flex-col min-h-screen">
    {/* Header */}
    <div class="sticky top-0 z-50">
      <Header currentChapter={chapter} />
    </div>

    {/* Body */}
    <div class="flex flex-1 relative">
      {/* Sidebar overlay for mobile */}
      <div
        id="sidebar-overlay"
        class="fixed inset-0 bg-black/50 z-20 hidden lg:hidden"
      ></div>

      {/* Sidebar */}
      <aside
        id="sidebar"
        class="fixed lg:static z-30 top-16 left-0 w-64 bg-surface-raised border-r border-border overflow-y-auto h-[calc(100vh-64px)] lg:sticky lg:top-16 shrink-0 -translate-x-full lg:translate-x-0 transition-transform duration-200"
      >
        <Sidebar
          lessons={chapterLessons}
          currentLessonId={currentLessonId}
          chapterTitle={chapterTitle}
        />
      </aside>

      {/* Main content */}
      <main class="flex-1 overflow-y-auto p-4 sm:p-8 lg:p-12">
        <div class="max-w-3xl mx-auto">
          <slot />
        </div>
      </main>
    </div>
  </div>

  <script>
    // Mobile sidebar toggle — uses the hamburger from the Header component
    const toggle = document.getElementById('header-menu-toggle');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebar-overlay');

    function openSidebar() {
      sidebar?.classList.remove('-translate-x-full');
      sidebar?.classList.add('translate-x-0');
      overlay?.classList.remove('hidden');
    }

    function closeSidebar() {
      sidebar?.classList.add('-translate-x-full');
      sidebar?.classList.remove('translate-x-0');
      overlay?.classList.add('hidden');
    }

    toggle?.addEventListener('click', (e) => {
      e.preventDefault();
      const isOpen = sidebar?.classList.contains('translate-x-0');
      if (isOpen) {
        closeSidebar();
      } else {
        openSidebar();
      }
    });

    overlay?.addEventListener('click', closeSidebar);
  </script>
</BaseLayout>
