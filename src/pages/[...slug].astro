---
import { getCollection, render } from 'astro:content';
import ChapterLayout from '../layouts/ChapterLayout.astro';
import GoPlayground from '../components/GoPlayground.astro';
import ProgressToggle from '../components/ProgressToggle.astro';
import LessonNav from '../components/LessonNav.astro';
import { chapters } from '../lib/chapters';
import { url } from '../lib/url';
import playgroundIds from '../lib/playground-ids.json';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  const sorted = lessons.sort((a, b) =>
    a.data.chapter !== b.data.chapter
      ? a.data.chapter - b.data.chapter
      : a.data.lesson - b.data.lesson
  );
  return sorted.map((lesson, index) => ({
    params: { slug: lesson.id },
    props: {
      lesson,
      prev: index > 0 ? sorted[index - 1] : null,
      next: index < sorted.length - 1 ? sorted[index + 1] : null,
      chapterLessons: sorted.filter(l => l.data.chapter === lesson.data.chapter),
    },
  }));
}

const { lesson, prev, next, chapterLessons } = Astro.props;
const { Content } = await render(lesson);
const chapter = chapters.find(c => c.number === lesson.data.chapter)!;
---
<ChapterLayout
  title={lesson.data.title}
  chapter={lesson.data.chapter}
  allLessons={chapterLessons}
  currentLessonId={lesson.id}
>
  <article class="prose">
    <h1>{lesson.data.title}</h1>
    <Content />
  </article>
  {lesson.data.code && <GoPlayground code={lesson.data.code} shareId={(playgroundIds as Record<string, string>)[lesson.id]} />}
  <ProgressToggle lessonId={lesson.id} />
  <LessonNav
    prev={prev ? { id: prev.id, title: prev.data.title } : null}
    next={next ? { id: next.id, title: next.data.title } : null}
  />

  <!-- Keyboard navigation hint (desktop only) -->
  <p class="hidden lg:block text-center text-gray-600 text-xs mt-6">
    &larr; &rarr; Use arrow keys to navigate
  </p>

  <!-- Hidden element for keyboard nav data -->
  <div id="lesson-nav-data" class="hidden" data-prev={prev ? url(`/${prev.id}`) : ''} data-next={next ? url(`/${next.id}`) : ''} />

  <script>
    const navData = document.getElementById('lesson-nav-data');
    if (navData) {
      const prevUrl = navData.dataset.prev;
      const nextUrl = navData.dataset.next;
      document.addEventListener('keydown', (e) => {
        // Don't navigate if user is typing in an input
        const tag = (e.target as HTMLElement).tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;

        if (e.key === 'ArrowLeft' && prevUrl) {
          window.location.href = prevUrl;
        } else if (e.key === 'ArrowRight' && nextUrl) {
          window.location.href = nextUrl;
        }
      });
    }
  </script>
</ChapterLayout>
