---
import type { Chapter } from '../lib/chapters';
import ProgressBar from './ProgressBar.astro';

interface Props {
  chapter: Chapter;
  firstLessonSlug: string;
}

const { chapter, firstLessonSlug } = Astro.props;
---

<a href={"/" + firstLessonSlug} class="block group">
  <div class="bg-surface-raised rounded-xl border border-border p-6 hover:border-go-cyan transition-all duration-200 h-full">
    <!-- Chapter number badge -->
    <div class="w-10 h-10 rounded-lg bg-go-cyan/10 text-go-cyan font-bold text-lg flex items-center justify-center mb-4">
      {chapter.number}
    </div>

    <!-- Title -->
    <h3 class="text-xl font-semibold text-white mb-2 group-hover:text-go-cyan transition-colors">
      {chapter.title}
    </h3>

    <!-- Description -->
    <p class="text-gray-400 text-sm mb-4 leading-relaxed">
      {chapter.description}
    </p>

    <!-- Progress bar -->
    <ProgressBar chapterSlug={chapter.slug} total={chapter.lessonCount} />
  </div>
</a>
