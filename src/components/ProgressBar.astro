---
interface Props { chapterSlug: string; total: number; }
const { chapterSlug, total } = Astro.props;
---
<div class="progress-bar" data-chapter={chapterSlug} data-total={total}>
  <div class="h-2 bg-surface rounded-full overflow-hidden">
    <div class="progress-fill h-full bg-go-cyan transition-all duration-300 rounded-full" style="width: 0%"></div>
  </div>
  <span class="progress-text text-xs text-gray-500 mt-1 block">0 / {total}</span>
</div>

<script>
  import { getProgress } from '../lib/progress';

  function updateAllBars() {
    const progress = getProgress();
    document.querySelectorAll('.progress-bar').forEach((bar) => {
      const chapter = bar.getAttribute('data-chapter')!;
      const total = parseInt(bar.getAttribute('data-total')!, 10);
      const completed = Object.keys(progress).filter(id => id.startsWith(chapter)).length;
      const pct = total > 0 ? (completed / total) * 100 : 0;
      const fill = bar.querySelector('.progress-fill') as HTMLElement;
      const text = bar.querySelector('.progress-text') as HTMLElement;
      if (fill) fill.style.width = `${pct}%`;
      if (text) text.textContent = `${completed} / ${total}`;
    });
  }

  updateAllBars();
  window.addEventListener('progress-changed', updateAllBars);
</script>
